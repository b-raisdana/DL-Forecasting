{
  "metadata": {
    "design_set": "DS-01",
    "name": "Six-Timeframe Hybrid Temporal Model",
    "version": "1.0.0",
    "description": "A hybrid temporal model that processes six different timeframes in parallel, extracts local and sequential features using ModernTCN and LSTM, fuses the information using a Perceiver architecture, models dependencies with Grouped Query Attention (GQA), and produces predictions through task-specific heads. Backbone width hyperparameters (ModernTCN_channels, LSTM_hidden_units, Perceiver_latent_tokens, Perceiver_latent_dim) are scaled ×1.5 from their original values (128/256/64/512) to better use the 8GB VRAM budget — see memory_budget below, computed per PROMPT.md § Memory sizing convention; every ratio between them is preserved exactly, depth/layer counts and kernel sizes are untouched, and MLP_width/MLP_depth stay at 512/4 since the prediction head's shape is held constant across candidates."
  },
  "preprocessed_input": "input-data-feature/Tier-1_000.atr_rel_ohlc_log_sma_v_extm_rel_6tf (handmade).input.jsonc",
  "outcome_heads": "outcome-label-target-head/Tier-1_000.action_mfe_rer (handmade).outcome.jsonc",
  "auxiliary_features": {
    "source": "preprocessed_input.candle_dataset, LAST candle only per timeframe branch (not the full window), flattened across all 6 branches",
    "role": "shared tabular snapshot feeding prediction_head.MLP's optional_auxiliary_features input and the LightGBM specialist — GBM operates on flattened features, distinct from the sequence-respecting LSTM/ModernTCN branches"
  },
  "the_model": {
    "per_timeframe_processing": {
      "architecture": "independent_parallel_branches",
      "branches": {
        "5m_encoded_sequence": {
          "temporal_encoder": [
            {
              "local_feature_extraction": "ModernTCN"
            },
            {
              "sequential_encoding": "LSTM"
            }
          ]
        },
        "15m_encoded_sequence": {
          "temporal_encoder": [
            {
              "local_feature_extraction": "ModernTCN"
            },
            {
              "sequential_encoding": "LSTM"
            }
          ]
        },
        "1H_encoded_sequence": {
          "temporal_encoder": [
            {
              "local_feature_extraction": "ModernTCN"
            },
            {
              "sequential_encoding": "LSTM"
            }
          ]
        },
        "4H_encoded_sequence": {
          "temporal_encoder": [
            {
              "local_feature_extraction": "ModernTCN"
            },
            {
              "sequential_encoding": "LSTM"
            }
          ]
        },
        "1D_encoded_sequence": {
          "temporal_encoder": [
            {
              "local_feature_extraction": "ModernTCN"
            },
            {
              "sequential_encoding": "LSTM"
            }
          ]
        },
        "1W_encoded_sequence": {
          "temporal_encoder": [
            {
              "local_feature_extraction": "ModernTCN"
            },
            {
              "sequential_encoding": "LSTM"
            }
          ]
        }
      }
    },
    "fusion": {
      "multitimeframe_fusion": {
        "Perceiver": {
          "mechanism": "latent_bottleneck_cross_attention",
          "pre_fusion": {
            "timeframe_identity_embedding": {
              "learnable_additive_embedding": {
                "one_per_branch": true,
                "dim": "LSTM_hidden_units", // "broadcast-added to every time-step of that branch's encoded_sequence, before concatenation into all_timeframe_sequences",
                "role": "lets cross-attention tell which timeframe a key/value token came from — concatenating the 6 branches otherwise carries no identity signal. Intra-branch order is left to the LSTM's own recurrence, not re-encoded here."
              }
            }
          },
          "inputs": [
            "5m_encoded_sequence",
            "15m_encoded_sequence",
            "1H_encoded_sequence",
            "4H_encoded_sequence",
            "1D_encoded_sequence",
            "1W_encoded_sequence"
          ],
          "latent_representation": {
            "learnable_latent_tokens": {
              "Perceiver_latent_tokens": "searchable"
            }
          },
          "cross_attention": {
            "query": "latent_tokens",
            "key": "all_timeframe_sequences",
            "value": "all_timeframe_sequences"
          },
          "role": "compress_and_integrate_cross_timeframe_information"
        }
      }
    },
    "dependency_modeling": {
      "attention": {
        "GQA": {
          "mechanism": "grouped_query_attention",
          "purpose": [
            "model_dependencies_between_latent representations",
            "capture_global interactions",
            "refine cross-timeframe representation"
          ],
          "layers": "searchable",
          "heads": "searchable",
          "kv_heads": "searchable"
        }
      },
      "regularization_and_stabilization": {
        "training_stability": {
          "normalization": {
            "LayerNorm": {
              "placement": "pre_norm"
            }
          },
          "residual_connections": {
            "skip_connections": "enabled"
          },
          "dropout": {
            "standard_dropout": "searchable"
          }
        }
      },
      "global_representation": {
        "pooling": "searchable"
      },
      "prediction_head": {
        "MLP": {
          "fusion_concatenation": {
            "inputs": [
              "deep_temporal_representation",
              "optional_auxiliary_features"
            ]
          },
          "each_layer": [
            {
              "Dense": "searchable",
              "activation": "searchable"
            },
            {
              "Dropout": "searchable"
            }
          ],
          "MLP_depth": "searchable",
          "MLP_width": "searchable"
        },
        "output_heads": {
          "defined_in": "outcome-label-target-head/Tier-1_000.action_mfe_rer (handmade).outcome.jsonc"
        }
      },
      "auxiliary_model": {
        "tabular_model": {
          "GBM": {
            "LightGBM": {
              "inputs": "auxiliary_features",
              "quantile_regression_loss": "pinball",
              "outputs": [
                "q10",
                "q50",
                "q90"
              ],
              "integration": {
                "external_ensemble": {
                  "inside_tensorflow_graph": false
                }
              }
            }
          }
        }
      }
    },
    "ensemble": {
      "model_combination": {
        "deep_model_plus_GBM": {
          "components": [
            "Keras_temporal_model",
            "LightGBM_tabular_model"
          ],
          "combination": {
            "calibrated_ensemble": {
              "weighting": "searchable"
            }
          }
        }
      }
    },
    "training": {
      "optimization": {
        "optimizer": "searchable",
        "scheduler": {
          "learning_rate_schedule": "searchable"
        },
        "mixed_precision": "enabled",
        "gradient_clipping": {
          "enabled": true,
          "norm": "searchable"
        }
      }
    }
  },
  "experiment_controller": {
    "hyperparameter_optimization": {
      "Optuna": {
        "pruning": {
          "enabled": true,
          "role": "terminate_unpromising_trials_early"
        }
      }
    }
  },
  "searchable_architecture_parameter_sets": {
    // stepping convention (base * 4 / base / 4 per level): see PROMPT.md § Rules
    // ModernTCN_channels/LSTM_hidden_units/Perceiver_latent_tokens/Perceiver_latent_dim base values are the original per-candidate defaults (128/256/64/512) scaled ×1.5, per PROMPT.md § Memory sizing convention — see metadata.description and memory_budget
    "1-base": {
      "input_set": 1, // 2, 3, 4 — selects a variation from preprocessed_input's "variations"
      "ModernTCN_kernel_size": 7, // 3, 11
      "ModernTCN_depth": 8, // 2, 32
      "ModernTCN_channels": 192, // 48, 768
      "LSTM_layers": 4, // 1 - intentionally is not stepped by 4.
      "LSTM_hidden_units": 384, // 96, 1536
      "LSTM_bidirectional": false, // true
      "Perceiver_latent_tokens": 96, // 24, 384
      "Perceiver_latent_dim": 768, // 192, 3072
      "Perceiver_cross_attention_layers": 8, // 2, 32
      "GQA_layers": 8, // 2, 32
      "GQA_heads": 8, // 32
      "GQA_kv_heads": 2, // 8
      // GQA model dimension = Perceiver_latent_dim
      // Perceiver_latent_dim % GQA_heads == 0
      // GQA_heads % GQA_kv_heads == 0
      // GQA_kv_heads < GQA_heads
      "MLP_depth": 4, // 2, 8 - intentionally is not stepped by 4.
      "MLP_width": 512, // 128, 2048
      "dropout": 0.1, // 0.0, 0.5
      "activation": "GELU", // ReLU, LeakyReLU, ELU
      "pooling_method": "last_token", // mean, max, attention
      "batch_size": 128, // 32, 512
      "learning_rate": 0.0003, // 0.00001, 0.001
      "weight_decay": 0.0001, // 0.0, 0.01
      "optimizer": "AdamW", // SGD, Adam, RMSprop
      "scheduler": "cosine", // step, exponential
      "gradient_clip_norm": 1.0, // 0.1, 5.0
      "outcome_set": 1, // 2 — selects a set from outcome_heads
      "ensemble_weighting": "validation_optimized_scalar" // fixed_equal_weight, stacked_meta_learner — see 03-Model & Architecture Engineering.md § combination strategies late_ensemble()
    }
  },
  "memory_budget": {
    // order-of-magnitude estimate for this file's "1-base" config, per PROMPT.md § Memory sizing convention — not profiler-measured, profile_trial_cost() is ground truth
    "hardware_reference": "RTX 4060 Laptop GPU, 8GB VRAM (8188 MiB), 64GB RAM — per 03-Model & Architecture Engineering.md#hardware-constraints",
    "model_parameters": {
      "vram_mb": 2191,
      "basis": "widths scaled ×1.5 from the original per-candidate defaults (see metadata.description); depth/layer counts and MLP shape unchanged. ModernTCN (depthwise kernel×channels + ConvFFN 2×channels×4channels per layer, depth=8, channels=192) ≈2.37M params/branch ×6 branches ≈14.2M; LSTM (4-gate formula, layers=4, hidden=384, layer-1 input=192 from ModernTCN) ≈4.43M/branch ×6 ≈26.6M; Perceiver cross-attention (Q/K/V/O + 4x FFN, latent_dim=768, source_dim=LSTM_hidden_units=384, layers=8, + latent-token bank 96×768) ≈52.0M; GQA (heads=8, kv_heads=2, d_model=768 [=Perceiver_latent_dim], layers=8) ≈49.5M; MLP head (width=512, depth=4 — held constant across candidates, input=pooled 768 + auxiliary_features 6×15=90) ≈1.2M. Total ≈143.6M params × 16 bytes/param (fp32 weights+grad+AdamW's 2 moment buffers, per Memory sizing convention) ≈2191MB"
    },
    "transient_activation_memory": {
      "vram_mb": 2450,
      "basis": "per branch: ModernTCN (batch128×seq256×channels192×depth8×2B) ≈96MiB + LSTM (batch128×seq256×hidden384×depth4×2B) ≈96MiB ≈192MiB/branch ×6 ≈1152MiB; Perceiver cross-attention over the concatenated 6×256=1536-token multi-tf sequence (batch128×seq1536×d_model384×layers8×2B) ≈1152MiB — largest single term, the concatenated pre-fusion sequence, not the post-bottleneck latent; GQA operates on the already-compressed 96 latent tokens (batch128×seq96×d_model768×layers8×2B) ≈144MiB, cheap precisely because Perceiver's bottleneck already compressed the sequence; MLP head negligible (~2MiB). Total ≈2450MiB, fp16/bf16 under this file's mixed_precision=enabled setting"
    },
    "preloaded_input_label_cache": {
      "ram_gb": "capacity-bound: ~485K samples against the RAM budget's 65% cache slice (41.6GB of 64GB)",
      "basis": "bytes/sample = 1536 total candles (256/tf × 6tf, input_set=1) × 15 candle_dataset fields (per input-data-feature Tier-1_000 base_definitions.candle_dataset: relative_OHLC×5 + V + higher_extremum_distance×8 + extremum_weight; tf_minutes/age_minutes/candle_offset excluded, commented out in source) × 4 bytes (float32) ≈92,160 bytes + outcome_set=1 label bytes (action_head one-hot ×3 + mfe/rer targets ×2, float32) ≈20 bytes ≈92,180 bytes (~90KB)/sample. Total training sample count isn't doc-resolved (open-ended symbol universe, per 02-Data, Label & Feature Engineering.md § training symbol universe) — sized as capacity against the budget slice instead of a fabricated total, per Memory sizing convention"
    },
    "other_memory_consumers": {
      "vram_mb": 2048,
      "ram_gb": 22.4,
      "basis": "fixed pipeline overhead, not candidate-specific — VRAM: CUDA/driver context (~5%) + pinned transfer buffer (~10%) + fragmentation headroom (~10%) of the 8188MiB card ≈2048MB; RAM: OS/dataloader-worker overhead (~10%) + pinned CPU→GPU staging (~15%) + headroom (~10%) of 64GB ≈22.4GB. LightGBM specialist's own training memory folds in here too — negligible against the cache slice at this feature scale"
    },
    "estimated_total": {
      "vram_mb": 6689,
      "vram_pct_of_8gb_card": "~82%",
      "flag": "widened ×1.5 (see metadata.description) to make fuller use of the 8GB card while keeping every width ratio between ModernTCN/LSTM/Perceiver/GQA fixed — up from ≈57% at the original (128/256/64/512) widths, still ≈18% below the card to cover the estimate's own order-of-magnitude uncertainty on top of the already-reserved other_memory_consumers slice. transient_activation_memory is the dominant scalable term (the Perceiver's cross-attention over the full concatenated 1536-token multi-tf sequence, before its latent bottleneck compresses things for GQA) — consistent with 03-Model & Architecture Engineering.md#hardware-constraints' finding that activation memory, not param count, binds VRAM. If profiling shows this too tight, reduce batch_size or gradient-checkpoint the Perceiver cross-attention stage first, per that section's Alt list; if profiling shows headroom instead, the same ×k scaling can be pushed further"
    }
  },
  "complete_flow": [
    "preprocessed_inputs",
    "six_parallel_timeframe_branches",
    "ModernTCN_local_feature_extraction",
    "LSTM_sequential_encoding",
    "Perceiver_cross_timeframe_fusion",
    "GQA_global_dependency_modeling",
    "searchable_pooling",
    "prediction_head",
    "task_specific_prediction_heads",
    "LightGBM_tabular_specialist",
    "calibrated_deep_model_GBM_ensemble",
    "Optuna_hyperparameter_optimization"
  ],
  "visualized": [
    "INPUT",
    "    │",
    "    ▼",
    "┌────────────────────────────────────────────────────┐",
    "│             SIX PARALLEL TIMEFRAME BRANCHES        │",
    "│                                                    │",
    "│  5m  → ModernTCN → LSTM ─┐                       │",
    "│ 15m  → ModernTCN → LSTM ─┤                       │",
    "│  1H  → ModernTCN → LSTM ─┤                       │",
    "│  4H  → ModernTCN → LSTM ─┼→ Perceiver            │",
    "│  1D  → ModernTCN → LSTM ─┤   latent bottleneck   │",
    "│  1W  → ModernTCN → LSTM ─┘   cross-attention     │",
    "└────────────────────────────────────────────────────┘",
    "    │",
    "    ▼",
    "GQA / Attention",
    "    │",
    "    ▼",
    "pooling",
    "    │",
    "    ▼",
    "MLP projection"
  ]
}
