#!/bin/sh
# Tracked source of truth for .git/hooks/pre-commit (that dir isn't versioned by git,
# so each clone runs `bash scripts/git-hooks/install.sh` once - see docs/infrastructure.md#environments).
#
# When Git runs on Windows, this hook delegates to the WSL "tf" conda environment, where
# the project dependencies live. When Git already runs in WSL/Linux, it executes there
# directly. Both paths run pre-commit against the same worktree and staged index.
#
# GIT_INDEX_FILE: for a partial/pathspec commit (`git commit -- <paths>`), Windows git sets
# this to a temp index (e.g. C:/Code/.../next-index-N.lock) and holds the REAL .git/index.lock
# for the whole hook run. wsl.exe doesn't forward Windows env vars into the WSL process by
# default, so without this, pre-commit's internal `git write-tree` falls back to the real
# (locked) index and deadlocks against the outer process - deterministically, every partial
# commit. WSLENV's /p flag forwards *and* translates the path (C:/... -> /mnt/c/...).
if ! command -v wsl.exe >/dev/null 2>&1; then
    exec pre-commit run --hook-stage pre-commit
fi

if [ -n "$GIT_INDEX_FILE" ]; then
    export WSLENV="GIT_INDEX_FILE/p:$WSLENV"
fi

# Do not assume a particular Windows checkout location. Git Bash reports the
# current worktree in Windows form, which WSLENV's /p flag converts before the
# WSL shell starts.
repo_root="$(git rev-parse --show-toplevel)"
if command -v cygpath >/dev/null 2>&1; then
    repo_root="$(cygpath -w "$repo_root")"
fi
export DLF_REPO_ROOT="$repo_root"
export WSLENV="DLF_REPO_ROOT/p:$WSLENV"

exec wsl.exe -d Ubuntu-24.04 -- bash -lc '
    source ~/miniconda3/etc/profile.d/conda.sh &&
    conda activate tf &&
    cd "$DLF_REPO_ROOT" &&
    pre-commit run --hook-stage pre-commit
'
